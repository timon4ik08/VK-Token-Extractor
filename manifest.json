{
  "manifest_version": 3,
  "name": "VK Token Extractor",
  "version": "1.0",
  "description": "Извлекает access token из VK",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Получить VK токен"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://vk.com/*",
    "https://*.vk.com/*"
  ]
}